# Скопируйте в .env и согласуйте значения с backend/.env.

# Ключ подписи сессионной cookie hr_session. ОБЯЗАН совпадать с SECRET_KEY
# бэкенда: иначе Next.js и FastAPI не примут сессии друг друга и пользователь
# будет разлогиниваться при переходе между разделами.
SECRET_KEY=

# База данных — та же, что у бэкенда, но в формате Prisma
# (у бэкенда: postgresql+psycopg://…, здесь без суффикса драйвера).
DATABASE_URL=postgresql://hr:hr_local_dev@localhost:5432/hr_helper

# Адрес FastAPI: туда проксируется всё, что ещё не перенесено на Next.js.
BACKEND_URL=http://localhost:8000

# Флаги сессионной cookie — как в backend/.env.
# secure=true требует HTTPS, иначе браузер не сохранит cookie.
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax

# --- Фоновые задачи (планировщик) ---------------------------------------------
# Общий секрет для POST /api/cron/[job]. Без него маршрут отвечает 503 и джобы
# не запускаются: этим же ключом защищено автоудаление персональных данных.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Куда воркер (npm run worker) стучится за запуском джобов.
WORKER_TARGET_URL=http://127.0.0.1:3000

# Время жизни содержимого с ПДн, минуты. ОБЯЗАНО совпадать с PII_TTL_MINUTES
# из backend/services/documents/pii_policy.py, иначе два бэкенда будут удалять
# одни и те же данные в разные сроки.
PII_TTL_MINUTES=60

# --- Web Push -----------------------------------------------------------------
# По умолчанию ключи читаются из backend/db/vapid.json (их генерирует Python).
# Переопределить можно здесь; приватный ключ принимается и в PEM (как в
# backend/.env), и в «сыром» base64url. Пара ОБЯЗАНА быть общей с бэкендом —
# иначе подписки, выданные под другим ключом, перестанут работать.
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
