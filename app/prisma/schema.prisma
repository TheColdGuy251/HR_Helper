// Схема БД HR-помощника. Источник истины - этот файл: структура меняется
// через Prisma Migrate (`npx prisma migrate dev`), история - в prisma/migrations.
//
// Соглашения:
//  - первичные ключи - UUIDv7 (uuidv7() из PostgreSQL 18). Они упорядочены по
//    времени создания, поэтому сортировка по id совпадает с хронологией;
//  - у таблиц-связок (голоса, реакции, прочтения, теги) ключ составной, без
//    суррогатного id;
//  - время - timestamptz, закрытые списки значений - enum;
//  - JSON - jsonb, кроме полей, где важен порядок ключей (my_documents.fields,
//    pii_persons.meta): jsonb его не сохраняет;
//  - ограничения, которых нет в языке Prisma (CHECK, частичный уникальный
//    индекс, NULLS NOT DISTINCT), добавлены SQL-ом в миграции init.
//
// Колонки-"водяные знаки" (dialogues.memory_covers_up_to,
// messenger_reads.last_read_id) и ключ группы chat_messages.variant_group
// хранят id сообщений для сравнения "раньше/позже", а не ссылку на строку,
// поэтому внешних ключей у них нет намеренно.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Перечисления

enum user_sex {
  male
  female
}

enum chat_role {
  user
  assistant
}

/// Чем создан документ пользователя: шаблоном из doc_templates или одним из
/// встроенных генераторов (lib/docs/*).
enum document_generator {
  template
  vacancy
  pps_announcement
  ot_dedup
  employee_certificate
  dpo_report
  dismissed_inventory
  process_schema
  characteristic
}

enum document_status {
  draft
  ready
  exported
}

enum kb_source_type {
  local
  web
  upload
}

enum kb_status {
  pending
  parsing
  indexed
  failed
}

enum kb_document_kind {
  code
  law
  regulation
  order
  manual
  other
}

enum kb_link_target {
  article
  chapter
  clause
  section
}

enum crawl_status {
  ok
  error
}

enum notification_kind {
  web_update
  doc_expired
  doc_stale
  pii_autodeleted
}

enum pii_action {
  create_person
  view_person
  delete_person
  import_1c
  upload
  download
  delete
  quick_analyze
  reauth_ok
  reauth_fail
}

enum pii_entity {
  person
  document
}

// Пользователи

model users {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  username       String    @unique @db.VarChar(64)
  email          String    @unique @db.VarChar(255)
  password_hash  String    @db.VarChar(255)
  surname        String    @db.VarChar(64)
  name           String    @db.VarChar(64)
  patronymic     String?   @db.VarChar(64)
  position       String    @db.VarChar(128)
  sex            user_sex?
  // Права независимы друг от друга (администратор с доступом к ПДн, но не
  // редактор БЗ и т.п.), поэтому это отдельные флаги, а не одна "роль".
  is_active      Boolean   @default(true)
  is_admin       Boolean   @default(false)
  is_kb_editor   Boolean   @default(false)
  can_access_pii Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  dialogues          dialogues[]
  my_documents       my_documents[]
  sent_messages      user_messages[]          @relation("message_sender")
  received_messages  user_messages[]          @relation("message_recipient")
  message_files      user_message_files[]
  message_reactions  user_message_reactions[]
  hidden_messages    user_message_hidden[]
  poll_votes         poll_votes[]
  messenger_reads    messenger_reads[]        @relation("read_owner")
  read_by_peers      messenger_reads[]        @relation("read_peer")
  news_posts         news_posts[]
  news_media         news_media[]
  notifications      notifications[]
  notification_reads notification_reads[]
  push_subscriptions push_subscriptions[]
  pii_documents      pii_documents[]
  pii_audit          pii_audit[]
}

model push_subscriptions {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  user_agent String?  @db.VarChar(400)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Ассистент

/// Диалог с ассистентом. Раньше между диалогом и сообщениями была таблица
/// chat_sessions, но сессия всегда была ровно одна - её id заменил id диалога.
model dialogues {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id             String             @db.Uuid
  title               String             @default("Без названия") @db.VarChar(255)
  description         String?
  is_finished         Boolean            @default(false)
  // Сводка старых сообщений (conversational memory) и id последнего сообщения,
  // которое в неё вошло (NULL - сводки ещё нет).
  memory_summary      String?
  memory_covers_up_to String?            @db.Uuid
  draft               String?
  // Сообщения мессенджера, пересланные в диалог и ещё не отправленные.
  pending_forward     Json?
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  last_activity       DateTime           @default(now()) @db.Timestamptz(6)
  user                users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages            chat_messages[]
  attachments         chat_attachments[]

  @@index([user_id])
}

model chat_messages {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dialogue_id            String             @db.Uuid
  role                   chat_role
  content                String             @default("")
  is_read                Boolean            @default(false)
  is_finished            Boolean            @default(true)
  is_cancelled           Boolean            @default(false)
  // Снимки того, что было показано пользователю (источники, подзапросы,
  // проверка фактов): история ответа, а не ссылки на живые строки.
  sources                Json?
  subqueries             Json?
  fact_check             Json?
  // Документ, сгенерированный ассистентом в этом ответе.
  attachment_document_id String?            @db.Uuid
  meta                   Json?
  forwarded_meta         Json?
  // Последний переданный seq - для возобновления стрима.
  last_seq               Int                @default(0)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  finished_at            DateTime?          @db.Timestamptz(6)
  // Варианты ответа: все ответы на один вопрос делят variant_group (= id
  // первого варианта), variant_active - показываемый вариант. reply_to -
  // вопрос, на который отвечает ассистент; branch_of - ответ, после которого
  // был задан вопрос (вместе они образуют дерево ветвления).
  variant_group          String?            @db.Uuid
  variant_active         Boolean            @default(true)
  reply_to               String?            @db.Uuid
  branch_of              String?            @db.Uuid
  dialogue               dialogues          @relation(fields: [dialogue_id], references: [id], onDelete: Cascade)
  attachment_document    my_documents?      @relation(fields: [attachment_document_id], references: [id], onDelete: SetNull)
  reply_to_message       chat_messages?     @relation("chat_reply", fields: [reply_to], references: [id], onDelete: SetNull)
  replies                chat_messages[]    @relation("chat_reply")
  branch_of_message      chat_messages?     @relation("chat_branch", fields: [branch_of], references: [id], onDelete: SetNull)
  branches               chat_messages[]    @relation("chat_branch")
  feedback               chat_feedback?
  attachments            chat_attachments[]

  // Цель составного внешнего ключа chat_attachments(message_id, dialogue_id).
  @@unique([id, dialogue_id])
  @@index([dialogue_id])
  @@index([variant_group])
  @@index([attachment_document_id])
}

/// Оценка ответа ассистента. Ставит её владелец диалога, поэтому автор
/// определяется через сообщение -> диалог и отдельной колонкой не хранится.
model chat_feedback {
  message_id String        @id @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  message    chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

/// Файлы, загруженные в чат с ассистентом (раньше session_documents). Текст
/// извлекается при загрузке и хранится в content.
model chat_attachments {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dialogue_id String         @db.Uuid
  // Сообщение, к которому приложен файл; NULL - загружен, но ещё не отправлен.
  // Составной ключ не даёт привязать файл к сообщению другого диалога.
  message_id  String?        @db.Uuid
  filename    String         @db.VarChar(500)
  mime_type   String?        @db.VarChar(128)
  size_bytes  Int            @default(0)
  // Оригинал файла - для точных преобразований таблиц.
  stored_path String?        @db.VarChar(1000)
  content     String         @default("")
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  dialogue    dialogues      @relation(fields: [dialogue_id], references: [id], onDelete: Cascade)
  message     chat_messages? @relation(fields: [message_id, dialogue_id], references: [id, dialogue_id], onDelete: Cascade)

  @@index([dialogue_id])
  @@index([message_id])
}

/// Служебное key-value хранилище: состояние, которое должно пережить
/// перезапуск сервера (незаконченная генерация документа и т.п.).
model app_state {
  key        String   @id
  value      Json
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Шаблоны и документы

model template_categories {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String          @unique @db.VarChar(64)
  name        String          @db.VarChar(128)
  description String?         @db.VarChar(500)
  icon        String?         @db.VarChar(64)
  sort_order  Int             @default(100)
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  templates   doc_templates[]
}

model doc_templates {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key               String               @unique @db.VarChar(64)
  title             String               @db.VarChar(255)
  description       String?
  file_path         String               @db.VarChar(500)
  fields_schema     Json?
  extraction_prompt String?
  is_enabled        Boolean              @default(true)
  category_id       String?              @db.Uuid
  // Шаблон по умолчанию своей категории - не больше одного на категорию
  // (частичный уникальный индекс в миграции). Раньше это была ссылка
  // template_categories.default_template_id: цикл между таблицами, и она
  // могла указывать на шаблон чужой категории.
  is_default        Boolean              @default(false)
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  category          template_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  documents         my_documents[]

  @@index([category_id])
}

model my_documents {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id       String             @db.Uuid
  title         String             @default("Без названия") @db.VarChar(255)
  // Раньше и ключ шаблона, и имя встроенного генератора лежали строкой в
  // template_key - внешний ключ на doc_templates был невозможен.
  generator     document_generator
  template_id   String?            @db.Uuid
  file_path     String?            @db.VarChar(500)
  progress      Int                @default(0)
  status        document_status    @default(draft)
  fields        Json?              @db.Json
  // Документ содержит ПДн: скрыт из "Моих документов" и удаляется по TTL.
  is_pii        Boolean            @default(false)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  last_activity DateTime           @default(now()) @db.Timestamptz(6)
  user          users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  template      doc_templates?     @relation(fields: [template_id], references: [id], onDelete: SetNull)
  chat_messages chat_messages[]

  @@index([user_id])
  @@index([template_id])
}

// База знаний

model kb_documents {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title          String             @db.VarChar(500)
  source_type    kb_source_type
  // Путь к файлу или URL.
  source_uri     String             @db.VarChar(1000)
  // sha256 содержимого - для поиска дублей при загрузке.
  file_hash      String?            @db.VarChar(64)
  mime_type      String?            @db.VarChar(128)
  status         kb_status          @default(pending)
  // Вес при поиске: 1 - низкий, 2 - средний, 3 - высокий.
  priority       Int                @default(2)
  document_kind  kb_document_kind?
  issuer         String?            @db.VarChar(255)
  effective_from DateTime?          @db.Date
  effective_to   DateTime?          @db.Date
  // Архивная редакция - вне поиска.
  is_archived    Boolean            @default(false)
  // Число фрагментов в Qdrant - кэш внешнего хранилища.
  chunks_count   Int                @default(0)
  content        String?
  extra          Json?
  error          String?
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  indexed_at     DateTime?          @db.Timestamptz(6)
  tags           kb_document_tags[]
  links          kb_links[]
  notifications  notifications[]

  @@index([file_hash])
}

model kb_document_tags {
  document_id String       @db.Uuid
  tag         String
  document    kb_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([document_id, tag])
  @@index([tag])
}

/// Перекрёстная ссылка из текста документа: "см. ст. 81 ТК".
model kb_links {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  from_doc_id      String         @db.Uuid
  from_chunk_index Int?
  target_kind      kb_link_target @default(article)
  // Номер цели строкой - бывают "84.1".
  target_number    String         @db.VarChar(16)
  // Код документа ("ТК", "ГК"...); NULL - ссылка внутри того же документа.
  target_doc_hint  String?        @db.VarChar(64)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  document         kb_documents   @relation(fields: [from_doc_id], references: [id], onDelete: Cascade)

  @@index([from_doc_id])
  @@index([target_kind, target_number])
}

/// Веб-источник, который воркер периодически перечитывает.
model kb_sources {
  id                     String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                   String        @db.VarChar(255)
  url                    String        @unique @db.VarChar(1000)
  is_enabled             Boolean       @default(true)
  refresh_interval_hours Int           @default(24)
  priority               Int           @default(2)
  last_crawled_at        DateTime?     @db.Timestamptz(6)
  // Раньше в last_status лежал то "ok", то текст ошибки, обрезанный до 32 символов.
  last_status            crawl_status?
  last_error             String?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
}

/// Группа FAQ - блок из файла "чат-бот ...". Если в группе несколько записей,
/// бот сначала задаёт уточняющий вопрос, а записи различаются option_label.
/// Раньше block, source_file и clarify_question повторялись в записях группы.
model faq_groups {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key              String        @unique @db.VarChar(64)
  block            String        @default("") @db.VarChar(255)
  source_file      String?       @db.VarChar(255)
  clarify_question String?
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  entries          faq_entries[]
}

model faq_entries {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  group_id     String     @db.Uuid
  // Порядок внутри группы (0 - первая запись).
  position     Int        @default(0)
  // Формулировки запроса, по которым запись находится.
  variants     Json?
  option_label String?    @db.VarChar(500)
  answer       String     @default("")
  doc_refs     Json?
  contact      String?
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  group        faq_groups @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, position])
}

// Мессенджер

model user_messages {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sender_id      String                   @db.Uuid
  // NULL вместе с is_general - общий чат (согласованность - CHECK в миграции).
  recipient_id   String?                  @db.Uuid
  is_general     Boolean                  @default(false)
  content        String                   @default("")
  forwarded_meta Json?
  reply_to_id    String?                  @db.Uuid
  is_pinned      Boolean                  @default(false)
  is_edited      Boolean                  @default(false)
  // Вопрос ассистенту из переписки (плашка "Вопрос ассистенту").
  is_ai_query    Boolean                  @default(false)
  created_at     DateTime                 @default(now()) @db.Timestamptz(6)
  sender         users                    @relation("message_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient      users?                   @relation("message_recipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  reply_to       user_messages?           @relation("message_reply", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies        user_messages[]          @relation("message_reply")
  files          user_message_files[]
  reactions      user_message_reactions[]
  hidden_for     user_message_hidden[]
  poll           polls?

  @@index([sender_id])
  @@index([recipient_id])
  @@index([is_general])
  @@index([is_pinned])
}

/// "Удалено у себя": сообщение скрыто для конкретного пользователя.
/// Раньше это был JSON-список id в user_messages.hidden_for.
model user_message_hidden {
  message_id String        @db.Uuid
  user_id    String        @db.Uuid
  message    user_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([message_id, user_id])
  @@index([user_id])
}

model user_message_files {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // NULL - загружен, но ещё не отправлен.
  message_id    String?        @db.Uuid
  owner_id      String         @db.Uuid
  original_name String         @db.VarChar(500)
  stored_path   String         @db.VarChar(1000)
  content_type  String?        @db.VarChar(128)
  size_bytes    Int            @default(0)
  is_image      Boolean        @default(false)
  img_w         Int?
  img_h         Int?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  message       user_messages? @relation(fields: [message_id], references: [id], onDelete: Cascade)
  owner         users          @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([owner_id])
}

/// Реакция-эмодзи: у пользователя на сообщении - не больше одной.
model user_message_reactions {
  message_id String        @db.Uuid
  user_id    String        @db.Uuid
  emoji      String        @db.VarChar(16)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  message    user_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([message_id, user_id])
  @@index([user_id])
}

/// Докуда пользователь дочитал диалог. peer_user_id - собеседник, NULL -
/// общий чат (раньше строка peer_key: то id, то слово "general").
model messenger_reads {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id      String    @db.Uuid
  peer_user_id String?   @db.Uuid
  last_read_id String?   @db.Uuid
  last_read_at DateTime? @db.Timestamptz(6)
  user         users     @relation("read_owner", fields: [user_id], references: [id], onDelete: Cascade)
  peer         users?    @relation("read_peer", fields: [peer_user_id], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT (в миграции): у общего чата отметка тоже одна.
  @@unique([user_id, peer_user_id])
  @@index([peer_user_id])
}

// Опросы (мессенджер и новости)

/// Опрос принадлежит ровно одному владельцу - сообщению мессенджера или посту
/// новостей (CHECK в миграции). Раньше у новостей были свои три таблицы той
/// же структуры (news_polls, news_poll_options, news_poll_votes).
model polls {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  message_id     String?        @unique @db.Uuid
  post_id        String?        @unique @db.Uuid
  question       String         @db.VarChar(300)
  description    String?
  allow_multiple Boolean        @default(false)
  show_voters    Boolean        @default(false)
  // Можно ли снять/поменять голос; в новостях - всегда можно.
  allow_change   Boolean        @default(true)
  // Может ли голосовать ассистент (только мессенджер).
  allow_bot      Boolean        @default(true)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  message        user_messages? @relation(fields: [message_id], references: [id], onDelete: Cascade)
  post           news_posts?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  options        poll_options[]
}

model poll_options {
  id       String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  poll_id  String       @db.Uuid
  text     String       @db.VarChar(300)
  position Int          @default(0)
  poll     polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  votes    poll_votes[]

  @@index([poll_id])
}

/// Голос. Опрос определяется вариантом, поэтому poll_id здесь больше нет -
/// он был транзитивной зависимостью (голос -> вариант -> опрос).
model poll_votes {
  option_id  String       @db.Uuid
  user_id    String       @db.Uuid
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  option     poll_options @relation(fields: [option_id], references: [id], onDelete: Cascade)
  user       users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([option_id, user_id])
  @@index([user_id])
}

// Новости

model news_posts {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title        String       @db.VarChar(500)
  body_html    String       @default("")
  author_id    String?      @db.Uuid
  is_published Boolean      @default(true)
  is_pinned    Boolean      @default(false)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @db.Timestamptz(6)
  author       users?       @relation(fields: [author_id], references: [id], onDelete: SetNull)
  media        news_media[]
  poll         polls?

  @@index([author_id])
}

model news_media {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  post_id          String?     @db.Uuid
  // Номер во вложениях поста; NULL - файл встроен в текст. Раньше список
  // вложений с именами и размерами копировался в news_posts.attachments.
  attachment_order Int?
  original_name    String      @db.VarChar(500)
  stored_path      String      @db.VarChar(1000)
  mime_type        String?     @db.VarChar(128)
  size             Int         @default(0)
  is_image         Boolean     @default(false)
  uploaded_by      String?     @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  post             news_posts? @relation(fields: [post_id], references: [id], onDelete: Cascade)
  uploader         users?      @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([post_id])
}

// Уведомления

model notifications {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind        notification_kind
  // NULL - широковещательное (видно всем), иначе - только этому пользователю.
  user_id     String?              @db.Uuid
  title       String               @default("") @db.VarChar(500)
  body        String?
  // Связанный документ БЗ (для web_update - новая версия страницы).
  document_id String?              @db.Uuid
  extra       Json?
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  user        users?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document    kb_documents?        @relation(fields: [document_id], references: [id], onDelete: SetNull)
  reads       notification_reads[]

  @@index([kind])
  @@index([user_id])
  @@index([document_id])
}

/// Пользователь видел уведомление: гасит бейдж, само уведомление остаётся.
model notification_reads {
  notification_id String        @db.Uuid
  user_id         String        @db.Uuid
  read_at         DateTime      @default(now()) @db.Timestamptz(6)
  notification    notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user            users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([notification_id, user_id])
  @@index([user_id])
}

// Персональные данные

model pii_persons {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  surname    String          @db.VarChar(128)
  name       String          @db.VarChar(128)
  patronymic String?         @db.VarChar(128)
  birth_date DateTime?       @db.Date
  // Должность, отдел и т.п. - не шифруются; порядок ключей важен для показа.
  meta       Json?           @db.Json
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  documents  pii_documents[]

  // NULLS NOT DISTINCT (в миграции): без этого сотрудник без отчества или
  // даты рождения мог завестись дважды - NULL не равен NULL. Индекс ведётся
  // с surname и заодно обслуживает поиск по фамилии.
  @@unique([surname, name, patronymic, birth_date])
}

/// Зашифрованный файл сотрудника.
model pii_documents {
  id                String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  person_id         String      @db.Uuid
  original_filename String      @db.VarChar(500)
  // Имя зашифрованного файла в хранилище (случайный токен).
  storage_filename  String      @unique @db.VarChar(80)
  mime_type         String?     @db.VarChar(128)
  size_bytes        Int         @default(0)
  note              String?
  uploaded_by       String?     @db.Uuid
  uploaded_at       DateTime    @default(now()) @db.Timestamptz(6)
  person            pii_persons @relation(fields: [person_id], references: [id], onDelete: Cascade)
  uploader          users?      @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([person_id])
}

/// Журнал действий с ПДн. Ссылка на объект (entity, entity_id) полиморфная и
/// должна пережить его удаление - запись "удалил сотрудника" остаётся, -
/// поэтому внешнего ключа у entity_id нет.
model pii_audit {
  id        String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id   String?     @db.Uuid
  action    pii_action
  entity    pii_entity?
  entity_id String?     @db.Uuid
  extra     Json?
  at        DateTime    @default(now()) @db.Timestamptz(6)
  user      users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([at])
}
